{
  "name": "agent-office",
  "private": false,
  "version": "0.1.0",
  "description": "A live 3D mission control for coding agents",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "node scripts/dev.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1",
    "check:server": "node --check server/index.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "check:public": "node scripts/check-public.mjs",
    "verify:public": "npm run check:public && npm run lint && npm run build && npm run check:server"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
